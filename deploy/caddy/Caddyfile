# The proxy (SDD §3): HTTPS with Caddy's own local CA, the web app, and /api to the api. It overwrites the
# client-address header, so the api can trust it for the operator workstations (SES-04).
{
	admin off
}

localhost {
	tls internal
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
