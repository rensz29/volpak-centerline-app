# The proxy (SDD §3): HTTPS with Caddy's own local CA, the web app, and /api to the api. It overwrites the
# client-address header, so the api can trust it for the operator workstations (SES-04).
#
# CENTERLINE_SITE (deploy/.env): the names and addresses browsers open it at, comma-separated, e.g.
# "localhost, centerline.plant.local, 10.156.116.50". Its certificate covers each of them.
{
	admin off
	default_sni {$CENTERLINE_DEFAULT_SNI:localhost}
}

{$CENTERLINE_SITE:localhost} {
	tls internal
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
