# What the proxy serves, over HTTP or HTTPS (imported by http.Caddyfile and https.Caddyfile): the web app, and /api
# to the api. It overwrites the client-address header, so the api can trust it for the operator workstations (SES-04).
encode zstd gzip

handle /api/* {
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}

handle {
	root * /srv
	try_files {path} /index.html
	file_server
}

header {
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy no-referrer
	-Server
}

# The page is checked on every load, so a new version shows after a reload; its files carry a hash in their names and
# never change, so they're kept (the api sets its own headers)
@page not path /api/* /assets/*
header @page Cache-Control "no-cache"
@assets path /assets/*
header @assets Cache-Control "public, max-age=31536000, immutable"
